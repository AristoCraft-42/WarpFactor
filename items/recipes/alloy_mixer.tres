[gd_resource type="Resource" script_class="Recipe" format=3]

[ext_resource type="Script" path="res://items/recipe.gd" id="1_recipe"]
[ext_resource type="Script" path="res://items/consume.gd" id="2_consume"]
[ext_resource type="Script" path="res://items/consume_items.gd" id="3_consume_items"]
[ext_resource type="Script" path="res://items/produce.gd" id="4_produce"]
[ext_resource type="Script" path="res://items/item_stack.gd" id="5_stack"]
[ext_resource type="Script" path="res://items/produce_items.gd" id="6_produce_items"]
[ext_resource type="Resource" path="res://items/types/copper.tres" id="item_copper"]
[ext_resource type="Resource" path="res://items/types/lead.tres" id="item_lead"]
[ext_resource type="Resource" path="res://items/types/titanium.tres" id="item_titanium"]
[ext_resource type="Resource" path="res://items/types/alloy.tres" id="item_alloy"]

[sub_resource type="Resource" id="in_0"]
script = ExtResource("5_stack")
item = ExtResource("item_copper")
amount = 3

[sub_resource type="Resource" id="in_1"]
script = ExtResource("5_stack")
item = ExtResource("item_lead")
amount = 4

[sub_resource type="Resource" id="in_2"]
script = ExtResource("5_stack")
item = ExtResource("item_titanium")
amount = 2

[sub_resource type="Resource" id="consume_0"]
script = ExtResource("3_consume_items")
stacks = Array[ExtResource("5_stack")]([SubResource("in_0"), SubResource("in_1"), SubResource("in_2")])

[sub_resource type="Resource" id="out_0"]
script = ExtResource("5_stack")
item = ExtResource("item_alloy")
amount = 1

[sub_resource type="Resource" id="produce_0"]
script = ExtResource("6_produce_items")
stacks = Array[ExtResource("5_stack")]([SubResource("out_0")])

[resource]
script = ExtResource("1_recipe")
id = &"alloy_mixer"
consumes = Array[ExtResource("2_consume")]([SubResource("consume_0")])
produces = Array[ExtResource("4_produce")]([SubResource("produce_0")])
craft_time = 1.5
