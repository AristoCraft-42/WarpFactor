[gd_resource type="Resource" script_class="LevelDef" format=3]

[ext_resource type="Script" path="res://world/level_def.gd" id="1_level"]
[ext_resource type="Script" path="res://items/item_stack.gd" id="2_stack"]
[ext_resource type="Resource" path="res://items/types/copper.tres" id="item_copper"]
[ext_resource type="Resource" path="res://items/types/lead.tres" id="item_lead"]

[sub_resource type="Resource" id="start_0"]
script = ExtResource("2_stack")
item = ExtResource("item_copper")
amount = 300

[sub_resource type="Resource" id="start_1"]
script = ExtResource("2_stack")
item = ExtResource("item_lead")
amount = 100

[resource]
script = ExtResource("1_level")
id = &"first_steps"
title_key = "LEVEL_FIRST_STEPS_TITLE"
description_key = "LEVEL_FIRST_STEPS_DESC"
order = 1
map_path = "res://levels/maps/01_first_steps.fwmap"
starting_items = Array[ExtResource("2_stack")]([SubResource("start_0"), SubResource("start_1")])
