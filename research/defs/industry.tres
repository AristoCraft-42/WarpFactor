[gd_resource type="Resource" script_class="ResearchDef" format=3]

[ext_resource type="Script" path="res://research/research_def.gd" id="1_def"]
[ext_resource type="Resource" path="res://items/types/science_kit.tres" id="2_kit"]
[ext_resource type="Script" path="res://buildings/building_def.gd" id="3_building_script"]
[ext_resource type="Script" path="res://items/recipe.gd" id="4_recipe_script"]
[ext_resource type="Resource" path="res://buildings/defs/assembler.tres" id="b_assembler"]

[resource]
script = ExtResource("1_def")
id = &"industry"
name_key = "RESEARCH_INDUSTRY"
description_key = "RESEARCH_INDUSTRY_DESC"
sort_order = 40
cost_item = ExtResource("2_kit")
cost_amount = 30
prerequisites = Array[StringName]([&"mining"])
unlock_buildings = Array[ExtResource("3_building_script")]([ExtResource("b_assembler")])
unlock_recipes = Array[ExtResource("4_recipe_script")]([])
