unlock_buildings = Array[ExtResource("3_building_script")]([])
unlock_recipes = Array[ExtResource("4_recipe_script")]([ExtResource("r_build_conveyor"), ExtResource("r_build_junction"), ExtResource("r_build_router"), ExtResource("r_build_sorter"), ExtResource("r_build_bridge_conveyor"), ExtResource("r_build_unloader"), ExtResource("r_build_steel_conveyor"), ExtResource("r_build_steel_junction"), ExtResource("r_build_steel_router"), ExtResource("r_build_lift"), ExtResource("r_build_container"), ExtResource("r_build_large_container"), ExtResource("r_build_furnace"), ExtResource("r_build_coal_drill"), ExtResource("r_build_drill"), ExtResource("r_build_smeltery"), ExtResource("r_build_fast_drill"), ExtResource("r_build_science_workshop"), ExtResource("r_build_small_power_pole"), ExtResource("r_build_thermal_generator"), ExtResource("r_build_pipe"), ExtResource("r_build_underground_pipe"), ExtResource("r_build_water_tank"), ExtResource("r_build_pump"), ExtResource("r_build_boiler"), ExtResource("r_build_steam_generator"), ExtResource("r_build_accumulator"), ExtResource("r_build_stone_wall"), ExtResource("r_build_machine_gun")])
